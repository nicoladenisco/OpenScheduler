<database xmlns="http://db.apache.org/torque/5.0/templates/database"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://db.apache.org/torque/5.0/templates/database
        http://db.apache.org/torque/torque-5.0/documentation/orm-reference/database-5-0-strict.xsd"
          name="agenda"
          defaultIdMethod="none">

  <table name="PRESTAZIONI" idMethod="idbroker">
    <column name="PRESTAZIONI_ID" required="true" primaryKey="true" type="INTEGER" />
    <column name="CODICE"         required="true" size="64" type="VARCHAR" />
    <column name="DESCRIZIONE"    required="true" size="255" type="VARCHAR" />
  </table>

  <table name="RISORSE" idMethod="idbroker">
    <column name="RISORSE_ID"    required="true" primaryKey="true" type="INTEGER" />
    <column name="CODICE"        required="true" size="64" type="VARCHAR" />
    <column name="DESCRIZIONE"   required="true" size="255" type="VARCHAR" />
  </table>

  <table name="RISORSE_LINK" idMethod="none">
    <column name="ID_RISORSE"     required="true" primaryKey="true" type="INTEGER" />
    <column name="ID_PRESTAZIONI" required="true" primaryKey="true" type="INTEGER" />
    <column name="GRUPPO"         size="64" type="VARCHAR" />
    <foreign-key foreignTable="RISORSE">
      <reference local="ID_RISORSE" foreign="RISORSE_ID"></reference>
    </foreign-key>
    <foreign-key foreignTable="PRESTAZIONI">
      <reference local="ID_PRESTAZIONI" foreign="PRESTAZIONI_ID"></reference>
    </foreign-key>
  </table>

</database>
